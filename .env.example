# =====================================================================
# PDF RAG Chatbot - Environment Variables
# Copy this file to .env and fill in your API credentials
# Command: cp .env.example .env (Linux/Mac) or copy .env.example .env (Windows)
# =====================================================================

# 1. LLM Generation API (Meta LLaMA 3.1 70B via NVIDIA NIM)
NVIDIA_API_KEY=your_nvidia_llm_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/llama-3.1-70b-instruct

# 2. Embedding Model API (NVIDIA Nemotron-3-Embed-1B)
NVIDIA_EMBEDDING_API_KEY=your_nvidia_embedding_api_key_here
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
USE_NVIDIA_EMBEDDINGS=true

# 3. Optional: Groq API Key (if switching to Groq)
GROQ_API_KEY=your_groq_api_key_here
