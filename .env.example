# =====================================================================
# PDF RAG Chatbot - Environment Variables
# Copy this file to .env and fill in your API credentials
# Command: cp .env.example .env (Linux/Mac) or copy .env.example .env (Windows)
# =====================================================================

# 1. NVIDIA NIM API Configuration (Free Tier available at https://build.nvidia.com)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/llama-3.1-70b-instruct

# 2. Embedding Model Settings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# 3. Optional: Groq API Configuration (if switching from NVIDIA to Groq)
GROQ_API_KEY=your_groq_api_key_here
